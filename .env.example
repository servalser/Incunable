# ────────────────────────────────────────────────────────────────────────────
# Incunable — Fichier de configuration d'exemple
# Copiez ce fichier en .env et remplissez les valeurs pour votre installation.
# ATTENTION : ne committez JAMAIS votre .env — il contient vos secrets.
# ────────────────────────────────────────────────────────────────────────────

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME="Incunable"
APP_ENV=production          # local | production
APP_KEY=                    # généré par : php artisan key:generate
APP_DEBUG=false             # true en développement uniquement
APP_URL=https://votre-domaine.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ── Logs ────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error             # debug en développement, error en production

# ── Base de données ──────────────────────────────────────────────────────────
# MySQL/MariaDB (recommandé en production)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=incunable
DB_USERNAME=incunable_user
DB_PASSWORD=votre_mot_de_passe

# ── Session / Cache ──────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=480        # durée en minutes (8h de session)
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Mail ─────────────────────────────────────────────────────────────────────
# Note : les paramètres SMTP des alertes sont configurables depuis l'interface
# (Configuration > SMTP). Ces variables ne sont utilisées que comme fallback
# pour les e-mails système de Laravel (reset de mot de passe, etc.).
MAIL_MAILER=log             # log en développement — smtp en production
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Intelligence Artificielle ────────────────────────────────────────────────
# Le Conseiller IA peut utiliser deux providers :
#   groq   → API cloud Groq (rapide, gratuit jusqu'à 30 req/min)
#             → créer un compte sur https://console.groq.com
#   ollama → modèle local (données 100% sur votre machine, pas de quota)
#             → installer Ollama sur https://ollama.com
AI_PROVIDER=groq            # groq | ollama

# Groq (si AI_PROVIDER=groq)
GROQ_API_KEY=               # votre clé API Groq (commence par gsk_...)
GROQ_MODEL=llama-3.3-70b-versatile   # modèle gratuit recommandé

# Ollama (si AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b     # ou llama3.2, mistral, etc.

# ── Google Books API ─────────────────────────────────────────────────────────
# Utilisée pour la recherche de livres par ISBN/titre/auteur dans Dilicom.
# Aucune clé requise pour un usage basique (≤ 1 000 requêtes/jour).
# Pour un usage intensif, créez une clé sur https://console.cloud.google.com
GOOGLE_BOOKS_API_KEY=       # optionnel

# ── Intégration LibriWeb / Librisoft ────────────────────────────────────────
# Optionnel — à renseigner si le client utilise Librisoft comme logiciel de caisse.
# Ces valeurs peuvent aussi être configurées depuis l'interface :
# Configuration > Intégrations.
#
# Le webhook reçoit les mises à jour en temps réel depuis ETL4hub.
# La clé secrète doit correspondre à celle configurée dans ETL4hub.
WEBHOOK_SECRET_LIBRISOFT=   # clé secrète HMAC partagée avec ETL4hub

# ── Filesystem / AWS ────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# AWS S3 (optionnel — pour stocker les fichiers importés sur S3)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-3
# AWS_BUCKET=

# ── Vite ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
